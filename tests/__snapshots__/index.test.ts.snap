exports[`formatting newlines are preserved 1`] = `
"import type { MaybePromise } from "bun";

export async function exampleFnAsync(
  callback: (x: number) => MaybePromise<number>,
): Promise<number> {
  // do sync stuff
  const x = 1;

  // do async stuff
  const result = await callback(x);
  return result;
}
export function exampleFn(
  callback: (x: number) => Awaited<MaybePromise<number>>,
): number {
  // do sync stuff
  const x = 1;

  // do async stuff
  const result = callback(x);
  return result;
}

type SS = Promise<string>;

export async function anotherAsync(): SS {
  return "hi";
}
export function anotherSync(): Awaited<SS> {
  return "hi";
}
"
`;
